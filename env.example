# Paths for preprocessing
# Copy this file to .env and fill in your local paths

# Path to the Philly cluster job log JSON file
JOB_LOG_PATH=/path/to/cluster_job_log.json

# Path to the Philly cluster GPU utilization CSV file
GPU_UTIL_PATH=/path/to/cluster_gpu_util.csv

# Path where the preprocessed output pickle file will be saved
OUTPUT_PATH=/path/to/preprocessed_data_new.pkl
